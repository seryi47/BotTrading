[Unit]
Description=BotTrading - vigilante de precios (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajusta User y las rutas si clonaste en otro sitio o con otro usuario.
User=ubuntu
WorkingDirectory=/home/ubuntu/BotTrading
ExecStart=/home/ubuntu/BotTrading/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
