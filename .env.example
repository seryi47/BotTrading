# Copia este archivo a .env y rellena tus valores.
# (.env está en .gitignore: NUNCA se sube a GitHub)

# --- Telegram (obligatorio) ---
# Token del bot, te lo da @BotFather con /newbot
TELEGRAM_BOT_TOKEN=
# Tu chat id, te lo dice @userinfobot (o `python run.py --chat-ids`)
TELEGRAM_CHAT_ID=

# --- Cadencia (opcional; por defecto 300 = 5 min) ---
POLL_INTERVAL=300

# --- Notificación en el Mac (opcional, solo en local/macOS) ---
MAC_ALERTS=1
